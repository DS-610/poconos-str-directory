# Copy to .env.local and fill in when wiring up real services.
# Everything in the MVP works without these.

# Supabase (database + auth) — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (subscriptions) — https://stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_PRO_HOST=
STRIPE_PRICE_PROPERTY_MANAGER=
